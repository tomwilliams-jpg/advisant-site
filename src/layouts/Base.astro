---
import "../styles/global.css";
import { site, michigan, colorado, compliance } from "../data/site.js";

const { title, description, path = "/", schema, schema2 } = Astro.props;
const canonical = site.domain + path;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.legalName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={site.domain + "/og-image.jpg"} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:image" content={site.domain + "/og-image.jpg"} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#173055" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"
    rel="stylesheet" />

  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  {schema2 && <script type="application/ld+json" set:html={JSON.stringify(schema2)} />}
</head>
<body>

<a class="skip" href="#main">Skip to content</a>

<header class="masthead">
  <div class="wrap masthead__inner">
    <a class="brand" href="/">
      {site.logo
        ? <img src={site.logo} alt={site.shortName} width="631" height="184" />
        : <strong style="font-family:var(--display);font-weight:500;font-size:1.3rem">{site.shortName}</strong>}
      {!site.logo && <span>Enrolled Agents · Colorado &amp; Michigan</span>}
    </a>
    <nav class="nav" aria-label="Main">
      <a href="/tax-strategy/" aria-current={path === "/tax-strategy/" ? "page" : undefined}>Tax Strategy</a>
      <a href="/family-office/" aria-current={path === "/family-office/" ? "page" : undefined}>Family Office</a>
      <a href="/equity-compensation/" aria-current={path === "/equity-compensation/" ? "page" : undefined}>Employer Equity</a>
      <a href="/services/" aria-current={path === "/services/" ? "page" : undefined}>Services</a>
      <a href="/insights/" aria-current={path.startsWith("/insights") ? "page" : undefined}>Insights</a>
      <a href="/meet-our-team/" aria-current={path === "/meet-our-team/" ? "page" : undefined}>Team</a>
      <a href="/contact/" aria-current={path === "/contact/" ? "page" : undefined}>Contact</a>
      <a class="btn" href={site.portalUrl}>Client portal</a>
    </nav>
  </div>
</header>

<main id="main">
  <slot />
</main>

<footer class="foot">
  <div class="wrap">
    {site.logoLight && <img class="foot__logo" src={site.logoLight} alt={site.shortName} width="631" height="184" />}
    <div class="foot__grid">
      <div>
        <h4>{colorado.city}</h4>
        <p>
          {colorado.street}{colorado.suite ? `, ${colorado.suite}` : ""}<br />
          {colorado.city}, {colorado.region} {colorado.postal}<br />
          <a href={`tel:${colorado.phone.replace(/\D/g, "")}`}>{colorado.phone}</a><br />
          {colorado.hours}
        </p>
        <a href={`/${colorado.slug}/`}>Denver office &rarr;</a>
      </div>
      <div>
        <h4>{michigan.metro}</h4>
        <p>
          {michigan.city}, {michigan.region}<br />
          <a href={`tel:${michigan.phone.replace(/\D/g, "")}`}>{michigan.phone}</a><br />
          {michigan.hours}
        </p>
        <a href={`/${michigan.slug}/`}>Michigan office &rarr;</a>
      </div>
      <div>
        <h4>Firm</h4>
        <ul>
          <li><a href="/tax-strategy/">Tax Strategy</a></li>
          <li><a href="/family-office/">Family Office Services</a></li>
          <li><a href="/equity-compensation/">Employer Equity Planning</a></li>
          <li><a href="/services/">All Services</a></li>
          <li><a href="/insights/">Insights</a></li>
          <li><a href="/fit-check/">Advisor or preparer?</a></li>
          <li><a href="/meet-our-team/">Meet our team</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href={site.portalUrl}>Client portal</a></li>
        </ul>
      </div>
    </div>
    <div class="foot__base">
      <p>
        &copy; {new Date().getFullYear()} {site.legalName}. Enrolled agents licensed to
        practice before the Internal Revenue Service in all 50 states.
      </p>
      <p class="foot__links">
        <a href={compliance.advUrl}>Form ADV Part 2A</a>
        <a href={compliance.crsUrl}>Form CRS</a>
      </p>
      <p class="foot__disclosure">{compliance.rlaLine}</p>
      <p class="foot__disclosure">{compliance.taxSeparationLine}</p>
      <p class="foot__disclosure">
        {compliance.jurisdictionLine} For additional information, contact the FGFOS
        Compliance Department at {compliance.compliancePhone}.
      </p>
    </div>
  </div>
</footer>

</body>
</html>
